# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
#   cp .env.example .env

# Required for voice transcription + extraction (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Optional: override extraction model (default openai/gpt-oss-120b)
# GROQ_EXTRACT_MODEL=openai/gpt-oss-120b

# Optional: Apps Script web app /exec URL (created later by scripts/setup_apps_script.py)
APPS_SCRIPT_URL=

# Shared secret with the deployed Code.gs (must match SCRIPT_SECRET in the script).
# Required for STORE=sheets mode and for authenticated sync.
SCRIPT_SECRET=

# Per-user PIN logins: "name:pin" = writer, "name:pin:ro" = read-only.
# Leave empty to disable authentication entirely (local single-user use).
# APP_PINS=herney:1234,carla:5678,estudiante:9999:ro

# Optional: explicit signing secret for session cookies (derived from APP_PINS if unset)
# SESSION_SECRET=

# Source of truth: sqlite (default) or sheets (Sheets-first, SQLite as offline fallback)
# STORE=sheets

# Optional overrides
GUONCO_DB_PATH=data/guonco.sqlite
